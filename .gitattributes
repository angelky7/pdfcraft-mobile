# Source is checked in as LF whatever the developer's platform: the build runs on Linux, and a
# stray CRLF in a Gradle or Kotlin file is a debugging session nobody needs.
* text=auto eol=lf

*.bat text eol=crlf

# Binary: never normalised, never diffed as text.
*.png binary
*.jpg binary
*.jpeg binary
*.webp binary
*.so binary
*.jar binary
*.jks binary
*.p12 binary
*.keystore binary
