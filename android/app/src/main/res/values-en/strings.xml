    <string name="files_clear">Delete all copies</string>
    <string name="files_clear_body">Removes the copies inside the app; your originals stay put</string>
    <string name="files_clear_confirm_title">Delete the local copies?</string>
    <string name="files_clear_confirm_body">This deletes %1$d copies (%2$s). The original files are not touched. It cannot be undone.</string>
    <string name="files_footnote">The copies exist so the app can remember your page and your ink. Deleting one leaves the original where it was.</string>

