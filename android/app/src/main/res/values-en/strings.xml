    <!-- Banners -->
    <string name="banner_local_title">Local by design</string>
    <string name="banner_local_body">No upload, no account, no network. The copy stays in the app; your original is untouched.</string>
    <string name="banner_local_action">Choose a file</string>
    <string name="banner_ink_title">Write with a pen, turn with a finger</string>
    <string name="banner_ink_body">The stylus writes and highlights, a finger scrolls and zooms — and a finger can write too when there is no pen.</string>
    <string name="banner_ink_action">Try a note</string>

    <!-- Files -->
    <string name="files_title">Files</string>
    <string name="files_summary">%1$d copies · %2$s</string>
    <string name="files_on_device">On this device</string>
    <string name="files_empty_body">Pick a PDF from the system file manager. It is copied into the app and listed here.</string>
    <string name="files_other">Other locations</string>
    <string name="files_browse_title">System file manager</string>
    <string name="files_browse_body">Choose a PDF from downloads, a chat, or a drive</string>
