    <!-- Home -->
    <string name="home_greeting">Welcome back</string>
    <string name="home_greeting_body">Pick up where you stopped, or open something new.</string>
    <string name="home_what">What would you like to do?</string>
    <string name="home_tab_recent">Recent</string>
    <string name="home_tab_starred">Starred</string>
    <string name="home_all_files">All files</string>
    <string name="home_empty_title">Nothing opened yet</string>
    <string name="home_empty_body">Pick a PDF to start. Documents you open stay here, and reopen where you stopped reading.</string>
    <string name="home_empty_starred">Nothing starred yet</string>
    <string name="home_empty_starred_body">Use the menu beside a document and choose Star, and it will appear here.</string>
    <string name="home_subtitle">Reads locally · writes with a pen</string>
    <string name="home_lead">Read PDFs on this device. Nothing is uploaded, no account is needed, and the file never leaves the phone.</string>
    <string name="home_recent">Recent</string>
    <string name="home_opening">Opening…</string>
    <string name="home_privacy">Everything happens on this device: no upload, no account, no network.</string>
    <string name="recent_detail">p. %1$d of %2$d · %3$s</string>
    <string name="unit_pages_read">%1$d of %2$d pages</string>

