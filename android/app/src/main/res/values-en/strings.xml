    <!-- Settings -->
    <string name="settings_title">Settings</string>
    <string name="settings_banner_title">Local by design</string>
    <string name="settings_banner_body">No account, no cloud, no upload. Documents are parsed and drawn on this device only.</string>
    <string name="settings_storage_value">%1$d copies · %2$s</string>
    <string name="settings_group_prefs">Preferences</string>
    <string name="settings_finger">A finger can write</string>
    <string name="settings_finger_body">Off: a finger only turns pages, and the stylus does the writing</string>
    <string name="settings_single">One page at a time</string>
    <string name="settings_single_body">Off: one continuous column. On: swipe sideways</string>
    <string name="settings_theme">Theme</string>
    <string name="settings_theme_system">Follow the system</string>
    <string name="settings_theme_light">Light</string>
    <string name="settings_theme_dark">Dark</string>
    <string name="settings_group_about">About</string>
    <string name="settings_version">Version</string>
    <string name="settings_license">Licence</string>
    <string name="settings_license_body">PdfCraft is released under MIT or Apache-2.0, at your option. The PDF engine comes from the upstream project storytold/pdfcraft; its notices and copyright lines ship with the repository in LICENSE, NOTICE and ATTRIBUTION.</string>
    <string name="settings_upstream">Upstream</string>
    <string name="settings_upstream_body">Reading and rendering come from github.com/storytold/pdfcraft (MIT OR Apache-2.0). The Android interface here is an independent implementation. PdfCraft is not affiliated with Adobe; Acrobat is a trademark of Adobe Inc.</string>
    <string name="settings_privacy">Privacy</string>
    <string name="settings_privacy_body">The app does not request the network permission: nothing is uploaded, counted or collected. Imported copies live in private app storage and go away when the app is uninstalled. Ink is written only into the copy you save.</string>
    <string name="settings_clear">Delete local copies</string>
    <string name="settings_clear_body">Remove every copy the app is holding</string>
    <string name="settings_footnote">PdfCraft is a local-first reader: no account, no cloud.</string>

